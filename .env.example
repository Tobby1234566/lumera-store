##############################################################################
# LUMÉRA — environment variables
#
# Copy to `.env` and fill in. NEVER commit `.env` to version control.
#   cp .env.example .env
#
# Every value below has a safe development default except where marked
# REQUIRED IN PRODUCTION.
##############################################################################

# ── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Public URL of the storefront. Used for CORS, canonical links and the sitemap.
APP_URL=http://localhost:5173

# Extra allowed browser origins (comma separated). Only enforced in production.
# CORS_ORIGINS=https://lumera.com,https://www.lumera.com


# ── Database ────────────────────────────────────────────────────────────────
# DB_CLIENT=sqlite  -> zero-config local file (default, great for development)
# DB_CLIENT=pg      -> PostgreSQL (recommended for production)
DB_CLIENT=sqlite
SQLITE_FILE=./data/lumera.sqlite

# Required when DB_CLIENT=pg
# DATABASE_URL=postgresql://user:password@host:5432/lumera
# DATABASE_SSL=true


# ── Admin authentication ────────────────────────────────────────────────────
# REQUIRED IN PRODUCTION. Generate with: openssl rand -base64 48
# JWT_SECRET=replace-with-a-long-random-string
SESSION_TTL_SECONDS=28800

# Credentials for the admin account created by `npm run db:seed`.
# Change these before seeding anything you intend to expose publicly.
ADMIN_EMAIL=admin@lumera.test
ADMIN_PASSWORD=lumera-admin
ADMIN_NAME=LUMÉRA Admin


# ── Payments ────────────────────────────────────────────────────────────────
# 'mock'   -> development simulation, no real money, no card data collected.
# 'stripe' -> real payments (complete server/src/services/payments/stripe.ts).
# The server REFUSES to boot in production with PAYMENT_PROVIDER=mock.
PAYMENT_PROVIDER=mock
CURRENCY=USD

# STRIPE_SECRET_KEY=sk_live_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx


# ── Store settings ──────────────────────────────────────────────────────────
SHIPPING_FLAT_RATE_CENTS=695
FREE_SHIPPING_THRESHOLD_CENTS=6000
# Decimal rate, e.g. 0.075 for 7.5%. Leave at 0 to disable tax calculation.
TAX_RATE=0


# ── Transactional email ─────────────────────────────────────────────────────
# 'console' -> emails are printed to the server log (nothing is sent).
# 'smtp'    -> real delivery (complete server/src/services/email.ts).
EMAIL_DRIVER=console
EMAIL_FROM="LUMÉRA <hello@lumera.example>"

# SMTP_HOST=smtp.postmarkapp.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=


# ── Client build-time variables (Vite) ──────────────────────────────────────
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# NEVER put a secret key here — anything VITE_* is publicly readable.
# Leave blank to use the dev proxy / same-origin API in production.
# VITE_API_URL=
# VITE_ANALYTICS_ID=
