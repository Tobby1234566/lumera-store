{
  "name": "lumera",
  "private": true,
  "version": "1.0.0",
  "description": "LUMÉRA — premium skincare e-commerce storefront, admin dashboard and API.",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --workspace server run dev",
    "dev:client": "npm --workspace client run dev",
    "build": "npm --workspace client run build && npm --workspace server run build",
    "start": "npm --workspace server run start",
    "db:migrate": "npm --workspace server run db:migrate",
    "db:seed": "npm --workspace server run db:seed",
    "db:reset": "npm --workspace server run db:reset",
    "test": "npm --workspace server run test",
    "typecheck": "npm --workspace client run typecheck && npm --workspace server run typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "playwright": "^1.49.1"
  }
}
